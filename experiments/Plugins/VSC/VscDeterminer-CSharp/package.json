{
	"name": "vsc-determiner-insiders",
	"displayName": "VscDeterminer (Experimental)",
	"description": "A plugin that determines which configuration `extensions.json` should be used using msbuild-like search algorithm.",
	"version": "2.0.0",
	"publisher": "vscPluginDeveloperJay30",
	"repository": {
		"type": "git",
		"url": "https://github.com/vscPluginDeveloperJay30/VscDeterminer.git"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onWorkspaceFolderOpen"
	],
	"main": "./out/src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "vscDeterminer.openSettingsManager",
				"title": "Open Workspace Settings Manager"
			},
			{
				"command": "vscDeterminer.viewWorkspaceSettings",
				"title": "View Workspace Settings"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "vscDeterminerContainer",
					"title": "Workspace Settings",
					"icon": "resources/settings-icon.svg"
				}
			]
		},
		"views": {
			"vscDeterminerContainer": [
				{
					"id": "vscSettingsExplorer",
					"name": "Workspace Settings Explorer"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "vscDeterminer.viewWorkspaceSettings",
					"when": "view == vscSettingsExplorer",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"test": "mocha out/tests/**/*.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.1",
		"@types/vscode": "^1.100.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"chai": "^6.2.2",
		"eslint": "^9.13.0",
		"memfs": "^4.68.1",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	}
}
