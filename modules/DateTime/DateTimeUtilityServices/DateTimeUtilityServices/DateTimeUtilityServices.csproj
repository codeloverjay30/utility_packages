<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0;net48;net472;net452</TargetFrameworks>
        <Version>2.0.0</Version>
        <PackageTags>$(PackageTags);DateTime</PackageTags>
    </PropertyGroup>
    <!-- check the version of .NET SDK of imported project is greater than or equal to .NET 6.0 -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <!-- check the version of .NET SDK of imported project is less than .NET 6.0 -->
    <PropertyGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>
</Project>