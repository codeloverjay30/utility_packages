<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;net472;net452</TargetFrameworks>

        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <ImplicitUsings Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp' And $([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 6.0">enable</ImplicitUsings>
        <Nullable Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp' And $([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8.0">enable</Nullable>

        <Version>2.0.0</Version>
        <PackageTags>$(PackageTags);type;check type;json</PackageTags>
    </PropertyGroup>
    
    <ItemGroup>
      <PackageReference Include="TypeUtilityServices" />
    </ItemGroup>
</Project>
