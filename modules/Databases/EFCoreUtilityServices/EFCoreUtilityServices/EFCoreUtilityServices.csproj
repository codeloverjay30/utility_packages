<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 透過C#語言的inline task來在編譯時期檢查該專案所使用的MSBuild版本和.NET SDK版本，若版本過舊則丟出編譯錯誤 -->
    <MinMSBuildReq>19.0</MinMSBuildReq>
    <MinNetSdkReq>10.0</MinNetSdkReq>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0-preview-1.0.0</Version>
    <PackageOutputPath>D:\workspace\MyLocalNuget\BlazorWebAssembly</PackageOutputPath>
    <PackageTags>$(PackageTags);EF Core;DbContext;Database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.EntityFrameworkCore"/>  
  </ItemGroup>
</Project>
