<Project>
	<PropertyGroup>
	  <NoWarn>$(NoWarn);NU1507</NoWarn>
	</PropertyGroup>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
<PropertyGroup>
    <MicrosoftExtensionsStableVersion>10.0.3</MicrosoftExtensionsStableVersion>
    <MicrosoftExtensionsPreviewVersion>11.0.0-preview.2.26159.112</MicrosoftExtensionsPreviewVersion>
  </PropertyGroup>
  <!-- If one didn't specify the package version, treat it as errors instead of warnings -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1008;NU1605</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- This applies to ALL projects in the repository automatically -->
    <GlobalPackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
  <!-- Test SDK -->
  <ItemGroup>
    <!-- Default policy: modern / unknown / platform-qualified TFM -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"
                    Version="17.14.1" />

    <!-- net452 compatibility override -->
    <PackageVersion Update="Microsoft.NET.Test.Sdk"
                    Version="16.0.1"
                    Condition="'$(TargetFramework)' == 'net452'" />
  </ItemGroup>
  <!-- Use .ASP .NET Core Framework -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.App.Ref" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.TeamFoundationServer.ExtendedClient" Version="20.256.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Security pin scoped to the NUKE build project only.

      _build currently receives NuGet.Packaging 6.12.1 transitively.
      6.12.5 is the patched release in the same 6.12 servicing line.
      Project scoping prevents this compatibility fix from downgrading
      projects that use newer NuGet 7.x libraries.
    -->
    <PackageVersion Include="NuGet.Packaging"
                    Version="6.12.5"
                    Condition="
                      '$(MSBuildProjectName)' == '_build'
                      And '$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Security transitive pin for .NET 10-family targets.

      Repository constraints observed in the project inventory / restore graph:
        - ThreadLevelLockingUtilityServices.Tests previously resolved 5.0.0.
        - _build -> Nuke.Common -> Microsoft.Build.Tasks.Core requires >= 9.0.0.

      9.0.18 is the patched .NET 9 package version for the July 2026
      System.Security.Cryptography.Xml advisories, while remaining on the
      9.x compatibility line instead of forcing the 10.x package line.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml"
                    Version="9.0.18"
                    Condition="
                      '$(TargetFramework)' == 'net10.0'
                      Or '$(TargetFramework)' == 'net10.0-windows'
                      Or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
  </ItemGroup>
  <ItemGroup>
  <!--
    Security transitive pin for net8.0.

    Dependency path:
    Microsoft.TeamFoundationServer.ExtendedClient 20.256.2
      -> Microsoft.IdentityModel.Tokens 8.7.0
      -> Microsoft.Bcl.Memory 9.0.0

    Microsoft.Bcl.Memory 9.0.0 is affected by
    CVE-2026-26127 / GHSA-73j8-2gch-69rq.
  -->
  <PackageVersion Include="Microsoft.Bcl.Memory"
                  Version="9.0.14"
                  Condition="'$(TargetFramework)' == 'net8.0'" />
</ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.6.0" />
  </ItemGroup>
  <!--  -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>
  <!-- Mock File System
       Default policy covers modern, unknown, outer-build and platform-qualified TFMs.
       Explicit legacy TFMs are overridden to the compatibility version. -->
  <ItemGroup>
    <PackageVersion Include="System.IO.Abstractions"
                    Version="22.1.1" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers"
                    Version="22.1.1" />

    <PackageVersion Update="System.IO.Abstractions"
                    Version="19.2.87"
                    Condition="
                    '$(TargetFramework)' == 'net452'
                    Or '$(TargetFramework)' == 'net461'
                    Or '$(TargetFramework)' == 'net462'
                    Or '$(TargetFramework)' == 'net471'
                    Or '$(TargetFramework)' == 'net472'
                    Or '$(TargetFramework)' == 'net48'
                    Or '$(TargetFramework)' == 'net481'
                    Or '$(TargetFramework)' == 'netstandard2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.1'
                    Or '$(TargetFramework)' == 'netcoreapp2.2'
                    Or '$(TargetFramework)' == 'netcoreapp3.0'
                    Or '$(TargetFramework)' == 'netcoreapp3.1'
                    Or '$(TargetFramework)' == 'net5.0'" />
    <PackageVersion Update="System.IO.Abstractions.TestingHelpers"
                    Version="19.2.87"
                    Condition="
                    '$(TargetFramework)' == 'net452'
                    Or '$(TargetFramework)' == 'net461'
                    Or '$(TargetFramework)' == 'net462'
                    Or '$(TargetFramework)' == 'net471'
                    Or '$(TargetFramework)' == 'net472'
                    Or '$(TargetFramework)' == 'net48'
                    Or '$(TargetFramework)' == 'net481'
                    Or '$(TargetFramework)' == 'netstandard2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.1'
                    Or '$(TargetFramework)' == 'netcoreapp2.2'
                    Or '$(TargetFramework)' == 'netcoreapp3.0'
                    Or '$(TargetFramework)' == 'netcoreapp3.1'
                    Or '$(TargetFramework)' == 'net5.0'" />
  </ItemGroup>
  <!-- abstraction of System Process -->
  <ItemGroup>
    <PackageVersion Include="System.Diagnostics.Abstractions" Version="1.0.9" />
  </ItemGroup>
  <!-- abstraction of System Process (used by older test framework such as `xUnit2`) -->
  <ItemGroup>
    <PackageVersion Include="Testably.Abstractions.FileSystem.Interface" Version="10.2.0" />
  </ItemGroup>
  <!-- abstraction of Environment class -->
  <ItemGroup>
    <PackageVersion Include="EnvironmentAbstractions" Version="5.0.0" />
    <!-- Mock Environment -->
    <PackageVersion Include="EnvironmentAbstractions.TestHelpers" Version="5.0.0" />
  </ItemGroup>
  <!-- `MSBuild`, simulating `MSBuild` behaviour -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Build" Version="18.4.0" />
  </ItemGroup>
  <!-- Locator of `MSBuild` -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
  </ItemGroup>
  <!-- Official utility packages about accessing version of NuGet package or .NET framework -->
  <ItemGroup>
    <!-- accessing version of  NuGet package -->
    <PackageVersion Include="NuGet.Protocol" Version="7.3.1" />
    <!-- accessing version of  .NET framework -->
    <PackageVersion Include="NuGet.Frameworks" Version="7.3.1" />
    <!-- About NuGet package versions -->
    <PackageVersion Include="NuGet.Versioning" Version="7.6.0" />
  </ItemGroup>
  <!-- Use traditional mode `VSTest` -->
  <!-- `NUnit` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
  </ItemGroup>
  <!-- `xUnit.v3` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>
  <!-- package that checks the class or property contains specific words, it uses `xUnit.v2` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>
  <!-- `xUnit.v2` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="xunit"
                    Version="2.9.3" />

    <!-- Default policy: modern / unknown / platform-qualified TFM -->
    <PackageVersion Include="xunit.runner.visualstudio"
                    Version="3.1.4" />

    <!-- net452 compatibility override -->
    <PackageVersion Update="xunit.runner.visualstudio"
                    Version="2.4.3"
                    Condition="'$(TargetFramework)' == 'net452'" />
  </ItemGroup>
  <!-- Use modern mode `MTP` -->
  <!-- use `MSTest` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.1.0" />
  </ItemGroup>
  <!-- use `NUnit` using `MTP` as Test Framework -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.TestPlatform" Version="18.4.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
  <!-- Default policy: modern / unknown / platform-qualified TFM -->
  <PackageVersion Include="FluentValidation"
                  Version="12.1.1" />

  <!-- Legacy compatibility overrides -->
  <PackageVersion Update="FluentValidation"
                  Version="8.6.3"
                  Condition="
                    '$(TargetFramework)' == 'net452'
                    Or '$(TargetFramework)' == 'net461'
                    Or '$(TargetFramework)' == 'net462'
                    Or '$(TargetFramework)' == 'net471'
                    Or '$(TargetFramework)' == 'net472'
                    Or '$(TargetFramework)' == 'net48'
                    Or '$(TargetFramework)' == 'net481'
                    Or '$(TargetFramework)' == 'netstandard2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.1'
                    Or '$(TargetFramework)' == 'netcoreapp2.2'
                    Or '$(TargetFramework)' == 'netcoreapp3.0'
                    Or '$(TargetFramework)' == 'netcoreapp3.1'
                    Or '$(TargetFramework)' == 'net5.0'" />
</ItemGroup>
<ItemGroup>
  <!-- Default policy: modern / unknown / platform-qualified TFM -->
  <PackageVersion Include="FluentAssertions"
                  Version="8.9.0" />

  <!-- Legacy compatibility overrides -->
  <PackageVersion Update="FluentAssertions"
                  Version="5.10.3"
                  Condition="
                    '$(TargetFramework)' == 'net452'
                    Or '$(TargetFramework)' == 'net461'
                    Or '$(TargetFramework)' == 'net462'
                    Or '$(TargetFramework)' == 'net471'
                    Or '$(TargetFramework)' == 'net472'
                    Or '$(TargetFramework)' == 'net48'
                    Or '$(TargetFramework)' == 'net481'
                    Or '$(TargetFramework)' == 'netstandard2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.0'
                    Or '$(TargetFramework)' == 'netcoreapp2.1'
                    Or '$(TargetFramework)' == 'netcoreapp2.2'
                    Or '$(TargetFramework)' == 'netcoreapp3.0'
                    Or '$(TargetFramework)' == 'netcoreapp3.1'
                    Or '$(TargetFramework)' == 'net5.0'" />
</ItemGroup>
  <!-- packages that mock the interface and virtual class -->
  <ItemGroup>
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <!-- packages that checks the AST of class (including, check a class contains property named `property1`) -->
  <ItemGroup>
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
  <!-- Rolsyn -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
  </ItemGroup>
  <!-- Rolsyn used for tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" />
  </ItemGroup>
  <!-- Roslynator -->
  <ItemGroup>
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0"/>
  </ItemGroup>
  <!-- SonarAnalyzer -->
  <ItemGroup>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.25.0.139117" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.7" />
    <PackageVersion Include="System.ClientModel" Version="1.10.0" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.3" />
  </ItemGroup>
  <!-- ============================================================
     Microsoft.Extensions package family

     CURRENT COMPATIBILITY POLICY

     Several internal packages in this repository currently declare exact
     dependencies on Microsoft.Extensions.* 11.0.0-preview.2.26159.112.

     Examples observed in the restore graph:
       * ExceptionHandlingUtilityServices
       * SerilogHelperServices
       * AzureUtilityServices
       * ILoggerBuilderFactoryServices

     With CentralPackageTransitivePinningEnabled=true, centrally pinning any
     affected package to 10.0.3 is an illegal downgrade and produces NU1109.

     Therefore these seven packages use the exact preview version repository-
     wide until those internal producer packages are rebuilt against a stable
     Microsoft.Extensions baseline.

     Microsoft.Extensions.Hosting and Hosting.Abstractions intentionally remain
     on the stable line elsewhere in this file because the current restore graph
     does not require their preview versions.
     ============================================================ -->
  <ItemGroup>

    <PackageVersion Include="Microsoft.Extensions.Logging"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.Options"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

    <PackageVersion Include="Microsoft.Extensions.Primitives"
                    Version="[$(MicrosoftExtensionsPreviewVersion)]" />

  </ItemGroup>


<!--
  Packages intentionally kept on the stable line.
-->
<ItemGroup>

  <PackageVersion Include="Microsoft.Extensions.Hosting"
                  Version="$(MicrosoftExtensionsStableVersion)" />

  <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions"
                  Version="$(MicrosoftExtensionsStableVersion)" />

</ItemGroup>
   <!-- Azure -->
  <ItemGroup>
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="Azure.Identity" Version="1.18.0" />
    <PackageVersion Include="Azure.Core" Version="1.51.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.5.0" />
  </ItemGroup>
  <!--  -->
  <ItemGroup>
    <PackageVersion Include="System.Management" Version="10.0.2" />
  </ItemGroup>
  <!-- Registry key on Windows OS -->
