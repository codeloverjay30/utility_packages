<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />

    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />

    <add key="github"
         value="https://nuget.pkg.github.com/codeloverjay30/index.json" />

    <add key="MyLocalBlazorWasmSource"
         value="D:\workspace\MyLocalNuget\BlazorWebAssembly\" />

    <add key="MyLocalNuGet"
         value="D:\workspace\MyLocalNuget\ClassLibrary\" />

    <add key="MyLocalRepo"
         value="./local-packages" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username"
           value="ANY_STRING" />

      <add key="ClearTextPassword"
           value="%GITHUB_TOKEN_ENV_VAR%" />
    </github>
  </packageSourceCredentials>

</configuration>